# Copy to .env.local and fill in.

# Google sign-in: create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your site
# (e.g. http://localhost:3000) under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Any long random string; signs the login cookie.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Without it, users are stored in ./data/users.json (local dev only).
MONGODB_URI=
MONGODB_DB=buttonHatesYou
